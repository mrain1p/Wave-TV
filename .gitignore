# Build output — regenerated by build.ps1 / build-aab.ps1 on every run.
build/
build-aab/
WaveTV.apk
WaveTV.aab
SubwaveTV.apk
*.idsig

# bundletool jar — downloaded once from github.com/google/bundletool releases;
# 32 MB of someone else's binary does not belong in this repository.
tools/

# Signing key and its password must never enter version control: whoever holds
# the keystore can publish "updates" that install over this app on real devices.
# Keep a backup somewhere safe — losing it means never updating the app again.
*.jks
*.keystore

# Local editor / tooling config — machine-specific, not part of the project.
.claude/

# Raw, unblurred screenshots. Only the redacted copies in docs/ get published.
docs/raw/

# One-off design briefs handed to the implementer. They describe a change that
# has already landed in the code, so publishing them adds nothing and dates
# badly — the code and its comments are the record.
picker-redesign-spec.md
*-redesign-spec.md
