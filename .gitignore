# Build output — regenerated by build.ps1 on every run.
build/
WaveTV.apk
SubwaveTV.apk
*.idsig

# Signing key and its password must never enter version control: whoever holds
# the keystore can publish "updates" that install over this app on real devices.
# Keep a backup somewhere safe — losing it means never updating the app again.
*.jks
*.keystore

# Local editor / tooling config — machine-specific, not part of the project.
.claude/

# Raw, unblurred screenshots. Only the redacted copies in docs/ get published.
docs/raw/
